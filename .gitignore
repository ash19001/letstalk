# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem

# debug and logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors: personal settings stay local, shared ones can be committed
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code: the project skills in .claude/skills are shared; personal settings and worktrees are not
.claude/settings.local.json
.claude/worktrees/

# design tooling: screenshots, sketches and caches are regenerated; the notes are kept
# (.impeccable/questions/ ignores itself)
.taste-skill/inspect*/
.impeccable/review/
.impeccable/decision/
.impeccable/hook.cache.json

# found pictures as downloaded; the copies the site uses live in public/images/world,
# and assets/credits.json records where each one came from
/assets/*
!/assets/credits.json

# downloaded OpenStreetMap data for the map generator (see docs/map.md)
/scripts/map/*.json
